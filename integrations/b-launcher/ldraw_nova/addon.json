{
  "id": "ldraw_nova",
  "name": "LDRAW-NOVA",
  "version": "0.3.1",
  "author": "KL",
  "description": "Builds LEGO models with the LDRAW-NOVA web app from a board node and saves the .mpd where you choose. Wire a Group into its refs input to send its photos, notes and colours. Needs the LDRAW-NOVA web app running (http://localhost:8765 by default) and B-Launcher add-on guide 1.4. Shows the finished snapshot in the node or on the board. Standard library only.",
  "entry": "main.py",
  "permissions": [
    "node_kinds",
    "panel",
    "notify",
    "read_boards"
  ],
  "job_timeout": 10800,
  "retries": 0,
  "node_kinds": [
    {
      "name": "lego_build",
      "label": "LEGO build",
      "blurb": "Sends the prompt, plus the photos, notes and colours of any Group wired into refs, to LDRAW-NOVA and saves the .mpd. Wire it into Open in program to open it in Stud.io.",
      "inputs": [
        {
          "name": "in",
          "type": "any",
          "required": false
        },
        {
          "name": "refs",
          "type": "images",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "mpd",
          "type": "file"
        }
      ],
      "fields": [
        {
          "key": "prompt",
          "label": "Prompt",
          "kind": "multiline",
          "default": ""
        },
        {
          "key": "notes",
          "label": "Notes from refs",
          "kind": "choice",
          "options": [
            "Use notes when Prompt is empty",
            "Add notes to my prompt",
            "Ignore notes"
          ],
          "default": "Use notes when Prompt is empty"
        },
        {
          "key": "ai",
          "label": "AI",
          "kind": "choice",
          "options": [
            "Default"
          ],
          "default": "Default"
        },
        {
          "key": "mode",
          "label": "Mode",
          "kind": "choice",
          "options": [
            "Build",
            "Plan only"
          ],
          "default": "Build"
        },
        {
          "key": "chat",
          "label": "Chat",
          "kind": "choice",
          "options": [
            "New chat",
            "Continue this node's chat"
          ],
          "default": "New chat"
        },
        {
          "key": "output",
          "label": "Save .mpd as",
          "kind": "save",
          "default": ""
        },
        {
          "key": "extras",
          "label": "Also save snapshot and parts list",
          "kind": "bool",
          "default": "yes"
        },
        {
          "key": "show",
          "label": "Show the finished picture",
          "kind": "choice",
          "options": [
            "In the node",
            "On the board, in a group",
            "Both",
            "Don't show it"
          ],
          "default": "In the node"
        }
      ]
    }
  ]
}
